UPSTREAM_BASE=https://api.openai.com/v1
UPSTREAM_API_KEY=
PROXY_API_TOKEN=change-me-long-random-token
REQUEST_TIMEOUT=600
REQUIRE_PROXY_AUTH=true
MODELS_CACHE_TTL=30

# MODEL_ALIASES format:
# - upstream_model: real upstream model name
# - reasoning_effort possible values: none, low, medium, high
# - hidden: optional boolean, hides alias from /v1/models while still allowing usage
#
# Default behavior:
# - if reasoning_effort is omitted for an alias, the proxy does NOT inject anything
# - if hidden is true for an alias, that alias is not listed in /v1/models
# - if the client already sends reasoning_effort, it is preserved
# - if the client already sends reasoning.effort, it is preserved
#
# Examples below:
# - ai-chat      -> no forced reasoning_effort
# - ai-tools     -> default low reasoning
# - ai-vision    -> default non-thinking
# - ai-summary   -> default non-thinking
# - ai-rag       -> default non-thinking
# - ai-translate -> default non-thinking

MODEL_ALIASES='{
  "ai-chat": {
    "upstream_model": "gpt-4.1"
  },
  "ai-tools": {
    "upstream_model": "gpt-4.1",
    "reasoning_effort": "low"
  },
  "ai-vision": {
    "upstream_model": "gpt-4.1",
    "reasoning_effort": "none"
  },
  "ai-summary": {
    "upstream_model": "gpt-4.1",
    "reasoning_effort": "none"
  },
  "ai-rag": {
    "upstream_model": "gpt-4.1",
    "reasoning_effort": "none"
  },
  "ai-translate": {
    "upstream_model": "gpt-4.1",
    "reasoning_effort": "none"
  }
}'

# LISTEN_HOST=0.0.0.0
# LISTEN_PORT=8000
